{
  "name": "@onemarketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json --noEmit false",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:generate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@imagekit/nodejs": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nats": "^2.29.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "catalog:",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@onemarketplace/eslint-config": "workspace:*",
    "@onemarketplace/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "supertest": "^7.3.2",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
