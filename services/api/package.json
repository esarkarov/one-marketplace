{
  "name": "@onemarketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "node node_modules/@typescript/native/bin/tsc --noEmit false",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "echo \"No tests yet\"",
    "db:generate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@imagekit/nodejs": "^7.10.0",
    "@oneminutelogs/express": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "nats": "^2.29.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "react": "catalog:",
    "redis": "^6.2.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@onemarketplace/eslint-config": "workspace:*",
    "@onemarketplace/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
