{
  "name": "@onemarketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "openapi:generate": "tsx src/openapi/generate.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:observed": "tsx watch --env-file=../../.env --import ./src/bootstrap/instrumentation.ts src/server.ts",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json --noEmit false && node scripts/rewrite-dist-aliases.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:observed": "node --import ./dist/bootstrap/instrumentation.js --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:generate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:test:create": "node --env-file-if-exists=../../.env ../../infra/scripts/test-db.mjs create",
    "db:test:migrate": "node --env-file-if-exists=../../.env ../../infra/scripts/test-db.mjs migrate",
    "db:test:setup": "pnpm db:test:create && pnpm db:test:migrate"
  },
  "dependencies": {
    "@clerk/backend": "^3.32.0",
    "@imagekit/nodejs": "^7.15.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-amqplib": "0.72.0",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-redis": "0.73.0",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.4.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "import-in-the-middle": "3.7.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "catalog:",
    "redis": "^6.4.0",
    "socket.io": "^4.8.3",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@onemarketplace/eslint-config": "workspace:*",
    "@onemarketplace/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "supertest": "^7.3.2",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^5.1.1"
  }
}
