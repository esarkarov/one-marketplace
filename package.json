{
  "name": "onemarketplace",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:quiet": "pnpm --silent --filter @onemarketplace/api test:quiet",
    "check": "pnpm format:check && pnpm -r --no-bail lint && pnpm -r --no-bail typecheck",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker/docker-compose.yml down -v",
    "infra:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
