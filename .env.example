# Required to start (Docker Postgres, Redis and RabbitMQ, and the API)
POSTGRES_USER=onemarketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onemarketplace
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me
REDIS_PORT=6379

RABBITMQ_USER=onemarketplace
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

DATABASE_URL=postgresql://onemarketplace:change-me@localhost:5432/onemarketplace
REDIS_URL=redis://:change-me@localhost:6379

TEST_DATABASE_URL=postgresql://onemarketplace:change-me@localhost:5432/onemarketplace_test
CREATE_TEST_DB_ADMIN_URL=

PORT=4000
NODE_ENV=development
TRUST_PROXY=

RABBITMQ_URL=amqp://onemarketplace:change-me@localhost:5672

CLERK_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTS_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=

IMAGEKIT_PRIVATE_KEY=

DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=

ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

CLIENT_DASHBOARD=http://localhost:<port>
FREELANCER_DASHBOARD=http://localhost:<port>
AGENCY_DASHBOARD=http://localhost:<port>
ADMIN_DASHBOARD=http://localhost:<port>

REFUND_RECONCILIATION_MODE=detect
ORPHAN_PAYMENT_DETECTION_MODE=detect

EXTERNAL_CALL_RETRIES=on

TELEMETRY_MODE=off
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
TELEMETRY_SERVICE_NAME=onemarketplace-api

# Optional host ports for pnpm infra:obs:up; read from the shell only, not from this file
# GRAFANA_PORT=3010
# OTEL_HTTP_PORT=4318