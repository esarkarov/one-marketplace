# Required to start (Docker Postgres and Redis, and the API)
POSTGRES_USER=onemarketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onemarketplace
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me
REDIS_PORT=6379

DATABASE_URL=postgresql://onemarketplace:change-me@localhost:5432/onemarketplace
REDIS_URL=redis://:change-me@localhost:6379

# Optional
PORT=4000
NODE_ENV=development

# Optional features: the API starts without these
NATS_URL=
ONE_MINUTE_LOGS_API_KEY=

CLERK_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTS_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=

IMAGEKIT_PRIVATE_KEY=

DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=

ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

CLIENT_DASHBOARD=
FREELANCER_DASHBOARD=
