{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm format *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm infra:up *)",
      "Bash(pnpm infra:down *)",
      "Bash(pnpm infra:logs *)",
      "Bash(pnpm run check *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run format *)",
      "Bash(pnpm run format:check *)",
      "Bash(pnpm run infra:up *)",
      "Bash(pnpm run infra:down *)",
      "Bash(pnpm run infra:logs *)",
      "Bash(pnpm -r lint)",
      "Bash(pnpm -r typecheck)",
      "Bash(pnpm -r build)",
      "Bash(pnpm -r --no-bail lint)",
      "Bash(pnpm -r --no-bail typecheck)",
      "Bash(pnpm -r --no-bail build)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm test:quiet *)",
      "Bash(pnpm --silent test:quiet *)",
      "Bash(pnpm --filter @onemarketplace/api test:quiet *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * test:quiet *)",
      "Bash(pnpm --filter * exec vitest run *)",
      "Bash(pnpm --filter * exec eslint *)",
      "Bash(pnpm --filter * exec prettier --check *)",
      "Bash(pnpm --filter @onemarketplace/api openapi:generate)",
      "Bash(pnpm --filter @onemarketplace/api-client generate)",
      "Bash(pnpm --filter @onemarketplace/api db:test:migrate)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(prettier --check *)",
      "Bash(node .claude/hooks/selftest.mjs)",
      "Bash(gitleaks git --config .gitleaks.toml *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh auth status)",
      "Bash(gh api *code-scanning/alerts*)",
      "Bash(node .claude/scripts/changed-areas.mjs)",
      "Bash(node .claude/scripts/commit-plan.mjs)",
      "Bash(sha256sum docs/api/openapi.json)"
    ],
    "ask": [
      "Bash(pnpm infra:reset *)",
      "Bash(pnpm run infra:reset *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(./.env*)",
      "Read(!.env.example)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(type *.env)",
      "Bash(type *.env.local)",
      "Bash(head *.env)",
      "Bash(head *.env.local)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(grep *.env)",
      "Bash(rg *.env)",
      "Bash(Get-Content *.env)",
      "Bash(Get-Content *.env.local)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git clean *)",
      "Bash(git apply *)",
      "Bash(git am *)",
      "Bash(git config *)",
      "Bash(git init *)",
      "Bash(git clone *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(rd *)",
      "Bash(del *)",
      "Bash(Remove-Item *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(tsx *scripts/*)",
      "Bash(node *scripts/*.ts*)",
      "Bash(pnpm tsx *scripts/*)",
      "Bash(pnpm * exec tsx *scripts/*)",
      "Bash(pnpm exec tsx *scripts/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --input *)"
    ]
  },
  "disabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.mjs"]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-generated.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-guard.mjs"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/trim-test-output.mjs"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-edited.mjs"]
          }
        ]
      }
    ]
  }
}
